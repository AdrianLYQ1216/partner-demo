LISTEN_ADDR=:18088
# Host / go run defaults (loopback). Docker Compose overrides these to
# host.docker.internal via DOCKER_GAME_API_BASE / DOCKER_WEB_BASE.
GAME_API_BASE=http://127.0.0.1:4000
WEB_BASE=http://127.0.0.1:5173

# Demo multi-tenant auth keys (facade login, not game secrets)
TENANT_ACME_DEMO_KEY=demo-acme-key
TENANT_GLOBEX_DEMO_KEY=demo-globex-key

# Partner JWT mint secrets — must match Texas PARTNER_<ID>_SECRET
PARTNER_ACME_SECRET=smoke-acme-secret
PARTNER_GLOBEX_SECRET=smoke-globex-secret

# Ledger X-API-Key — must match Texas SERVICE_API_KEY / SERVICE_API_KEYS
SERVICE_API_KEY=local-dev-service-api-key
# Optional per-tenant override: SERVICE_API_KEY_ACME=acme-credit-key

# Optional JSON alternative to TENANT_* / PARTNER_* env pairs:
# TENANTS_JSON=[{"id":"acme","demo_key":"demo-acme-key","partner_secret":"smoke-acme-secret","service_api_key":""}]

DEMO_TOKEN_TTL=1h
PARTNER_JWT_TTL=5m
